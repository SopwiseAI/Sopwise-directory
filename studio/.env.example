# 环境配置模板 - 复制为 .env.dev / .env.sit / .env.prod 并填写真实值
APP_ENV=dev
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

# MySQL（必填）
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# CORS（逗号分隔，必填）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# API Key（必填，生产环境必须使用强随机密钥）
API_KEY=

# 导出路径（可选，默认 ../web/data/data.json；实际写入 data-{env}.json，仅 prod 额外同步 data.json）
# EXPORT_OUTPUT_PATH=../web/data/data.json

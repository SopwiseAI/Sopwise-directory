# 环境配置模板 - 复制为 .env.dev / .env.sit / .env.prod 并填写真实值
APP_ENV=dev
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

# MySQL
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# JSON 导出路径（相对于 studio/ 目录）
EXPORT_OUTPUT_PATH=../web/data/data.json

# CORS（逗号分隔）
CORS_ORIGINS=http://localhost:3000

# API Key
API_KEY=

#!/usr/bin/env sh
# 防止污染生产数据源 (测试数据污染防护)
# 生产数据源: web/data/topics.json 与 web/data/tools.json (仅 prod 导出才会同步)
# 允许提交它们的分支: main 与 data/* (数据同步分支)
#   —— main 禁止直推(分支保护)，数据同步走 data/* 分支 + PR
# 旧的单文件 web/data/data.json 已随前端切换到 topics.json / tools.json 删除（见 web/lib/data.ts）。
branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
case "$branch" in
    main | data/*)
        # 允许
        ;;
    *)
        staged=$(git diff --cached --name-only)
        for f in web/data/topics.json web/data/tools.json; do
            if printf '%s\n' "$staged" | grep -Fxq "$f"; then
                echo "拒: 禁止在非 main 分支提交 $f (生产数据源)"
                echo "    topics.json / tools.json 仅 prod 环境导出同步, 更新请用 data/<name> 分支提 PR"
                echo "    本地测试前端: 用带环境后缀的副本 (web/data/topics-dev.json + tools-dev.json, 勿提交)"
                exit 1
            fi
        done
        ;;
esac

pnpm exec lint-staged

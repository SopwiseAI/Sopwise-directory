#!/usr/bin/env sh
# 防止污染生产数据源 data.json (测试数据污染防护)
# 允许提交 data.json 的分支: main 与 data/* (数据同步分支)
#   —— main 禁止直推(分支保护)，数据同步走 data/* 分支 + PR
branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
case "$branch" in
    main | data/*)
        # 允许
        ;;
    *)
        if git diff --cached --name-only | grep -q "^web/data/data.json$"; then
            echo "拒: 禁止在非 main 分支提交 web/data/data.json (生产数据源)"
            echo "    data.json 仅 prod 环境导出同步, 更新请用 data/<name> 分支提 PR"
            echo "    本地测试前端: cp web/data/data-dev.json web/data/data.json (勿提交)"
            exit 1
        fi
        ;;
esac

pnpm exec lint-staged

{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/AGENTS.md"],
  "watcher": {
    "ignore": [
      ".git/**",
      "**/node_modules/**",
      "**/__pycache__/**",
      "**/.pytest_cache/**",
      "**/.ruff_cache/**",
      "**/.venv/**",
      "**/.next/**",
      ".dsh-artifacts/**",
      "scripts/.state/**"
    ]
  },
  "snapshot": false,
  "mcp": {
    "mysql-dev": {
      "type": "local",
      "command": ["bash", "scripts/mcp-mysql.sh"],
      "environment": { "APP_ENV": "dev", "MYSQL_ALLOW_WRITE": "true" },
      "timeout": 10000
    },
    "mysql-sit": {
      "type": "local",
      "command": ["bash", "scripts/mcp-mysql.sh"],
      "environment": { "APP_ENV": "sit", "MYSQL_ALLOW_WRITE": "false" },
      "timeout": 10000
    },
    "mysql-prod": {
      "type": "local",
      "command": ["bash", "scripts/mcp-mysql.sh"],
      "environment": { "APP_ENV": "prod", "MYSQL_ALLOW_WRITE": "false" },
      "timeout": 30000
    }
  }
}

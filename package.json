{
  "name": "sopwise-directory",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "description": "AI-powered product discovery directory",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SopwiseAI/Sopwise-directory.git"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "format": "prettier --write \"*.md\" \"*.json\" \"*.jsonc\" \".opencode/**/*.md\" \"skills/**/*.md\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"*.md\" \"*.json\" \"*.jsonc\" \".opencode/**/*.md\" \"skills/**/*.md\" \".github/**/*.yml\"",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "check": "pnpm run lint:md && pnpm run format:check && cd studio && uv run ruff check app/ tests/ && cd ../web && pnpm lint",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9"
  },
  "lint-staged": {
    "*.md": [
      "prettier --write",
      "markdownlint-cli2 --fix"
    ],
    "*.{json,jsonc,yaml,yml}": [
      "prettier --write"
    ],
    "*.py": [
      "studio/.venv/bin/ruff check --fix",
      "studio/.venv/bin/ruff format"
    ],
    "*.{ts,tsx,js,jsx,mjs,cjs,css}": [
      "prettier --write"
    ]
  }
}

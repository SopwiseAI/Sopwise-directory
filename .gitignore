# env files（无斜杠模式在任意层级生效；保留 .env.example 可提交）
.env
.env.*
*.env
.envrc
.direnv/
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
.venv/
venv/
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
coverage.json
htmlcov/

# IDE（.vscode 只白名单化团队共享的两个文件，避免 .vscode/mcp.json 等带凭据的文件入库）
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# 工具缓存
.turbo/
.eslintcache

# Agent / 本地临时产物（原先只写在本机 .git/info/exclude，不随克隆分发）
.dsh-artifacts/
opencode.local.json

# scripts runtime
scripts/.run/

# export artifacts
# 环境副本（dev/sit 只有这两份，prod 会多写一份）不入库：
web/data/topics-*.json
web/data/tools-*.json
# 无后缀的 topics.json / tools.json 是 prod 同步出来的前端数据源，必须入库（不设忽略规则即可）。
# 旧命名产物（data.json 系列）在 web/ 完成前端切换前继续挡住，避免旧副本被误提交。
web/data/data-*.json

# skills api runtime
skills/tools/api.log
skills/tools/.op_ids

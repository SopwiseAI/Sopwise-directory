{
  "files.encoding": "utf-8",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  // 语言 ID 必须是 VS Code 官方 ID：.tsx 的是 typescriptreact（没有 tsx），
  // 写错整个块会被静默忽略；javascript / javascriptreact 同理覆盖 .js / .jsx。
  "[typescript]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "files.trimTrailingWhitespace": false,
    "editor.wordWrap": "on",
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[python]": {
    "editor.tabSize": 4,
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.renderWhitespace": "boundary",
  "diffEditor.ignoreTrimWhitespace": false,
  // 用仓库锁定的 TypeScript（web/ 内），避免 VS Code 内置版本与 web/package.json 不一致
  "typescript.tsdk": "web/node_modules/typescript/lib",
  "search.exclude": {
    "web/node_modules": true,
    "web/.next": true,
    "web/storybook-static": true,
    "studio/.venv": true,
    "studio/.ruff_cache": true,
    "studio/.pytest_cache": true,
    "scripts/.state": true,
    ".dsh-artifacts": true,
    "**/.pnpm-store": true
  },
  "python.defaultInterpreterPath": "studio/.venv/bin/python",
  // 导入根是 studio/ 而不是仓库根: app 与 tests 两个包都挂在它下面
  // (tests 里用 `from tests.conftest import ...`, 所以少了这条连测试都解析不了)。
  // mypy 侧靠 pyproject.toml 定位同一个根 —— 实测: 在仓库根直接跑
  // `studio/.venv/bin/mypy studio/app` 会满屏 import-not-found。
  // ⚠️ 这一条只影响编辑器补全/红线, 本机没有 VS Code 无法实测, 未验证。
  "python.analysis.extraPaths": ["studio"]
}
